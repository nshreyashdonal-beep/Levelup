# Copy this file to .env and fill in your real Postgres password.
# .env is git-ignored — it never gets committed, .env.example is just the template.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/levelup

# Any long random string works here — used to sign/verify login tokens.
JWT_SECRET=replace_this_with_a_long_random_string

# Razorpay Payment Gateway Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
